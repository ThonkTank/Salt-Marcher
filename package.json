{
  "name": "salt-marcher",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first tabletop campaign tool",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "import:references": "tsx scripts/import-srd-references.ts",
    "update:reference-goldens": "tsx scripts/update-reference-goldens.ts",
    "check:references": "tsx scripts/check-reference-artifact.ts",
    "build": "electron-vite build && tsx scripts/build-passive-preload.ts",
    "build:qualification": "tsx scripts/build-qualification.ts",
    "start": "electron-vite preview",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.renderer.json",
    "test": "vitest run",
    "test:smoke": "corepack pnpm build && tsx scripts/run-smoke.ts",
    "test:qualification-smoke": "corepack pnpm build:qualification && tsx scripts/run-smoke.ts --qualification",
    "test:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "test:packaged-smoke": "corepack pnpm package && tsx scripts/packaged-smoke.ts",
    "test:packaged-qualification-smoke": "corepack pnpm package:qualification && tsx scripts/packaged-smoke.ts --qualification",
    "test:e2e": "corepack pnpm build && wdio run wdio.conf.ts --suite create && wdio run wdio.conf.ts --suite restart && wdio run wdio.conf.ts --suite dialogs",
    "test:create:built": "wdio run wdio.conf.ts --suite create",
    "test:dialogs:built": "wdio run wdio.conf.ts --suite dialogs",
    "test:visual:update": "UPDATE_VISUAL_GOLDENS=1 corepack pnpm build && UPDATE_VISUAL_GOLDENS=1 wdio run wdio.conf.ts --suite create && UPDATE_VISUAL_GOLDENS=1 wdio run wdio.conf.ts --suite dialogs",
    "test:passive-e2e": "corepack pnpm build && wdio run wdio.passive.conf.ts",
    "qualify:render": "tsx scripts/run-render-qualification.ts",
    "qualify:rp-h": "tsx scripts/qualify-rp-h.ts",
    "qualify:render:validate": "tsx scripts/validate-render-qualification.ts",
    "qualify:render:artifacts": "tsx scripts/generate-render-qualification-artifacts.ts",
    "qualify:render:artifacts:check": "tsx scripts/check-render-qualification-artifacts.ts",
    "check": "corepack pnpm format && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm check:references && corepack pnpm qualify:render:artifacts:check && corepack pnpm test:smoke && corepack pnpm test:create:built && corepack pnpm test:dialogs:built && corepack pnpm test:bundle-budget",
    "package": "corepack enable --install-directory ./node_modules/.bin && corepack pnpm build && electron-builder --publish never",
    "package:qualification": "corepack enable --install-directory ./node_modules/.bin && corepack pnpm build:qualification && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@babylonjs/core": "9.18.1",
    "@floating-ui/react": "0.27.20",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/im-fell-english-sc": "5.3.0",
    "better-sqlite3": "13.0.2",
    "pixi.js": "8.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "4.12.1",
    "@electron-toolkit/utils": "4.0.0",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.30.0",
    "@wdio/electron-service": "10.1.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.0",
    "@wdio/mocha-framework": "9.30.0",
    "@wdio/spec-reporter": "9.29.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.6",
    "tar": "7.5.22",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "webdriverio": "9.30.0"
  },
  "pnpm": {
    "overrides": {
      "@wdio/native-utils": "2.5.0"
    }
  }
}
