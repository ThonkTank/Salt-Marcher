{
  "name": "saltmarcher",
  "version": "0.190.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node tools/run-tests.mjs",
    "test:desktop-weather": "node tools/run-tests.mjs --serial tests/runtime/desktop-weather-integrity.test.mjs tests/runtime/desktop-weather-authority.test.mjs",
    "test:desktop-live-moment": "node tools/run-tests.mjs --serial tests/runtime/desktop-live-moment-context.test.mjs",
    "test:desktop-narrative-basis": "node tools/run-tests.mjs --serial tests/runtime/desktop-narrative-basis.test.mjs",
    "test:desktop-narrative-journal": "node tools/run-tests.mjs --serial tests/runtime/desktop-narrative-journal-context.test.mjs",
    "test:desktop-session-review": "node tools/run-tests.mjs --serial tests/runtime/desktop-session-review-context.test.mjs tests/campaign/desktop-session-review-handler.test.mjs",
    "test:desktop-session-rewards": "node tools/run-tests.mjs --serial tests/runtime/desktop-session-reward-integrity.test.mjs",
    "test:desktop-archive-errors": "node tools/run-tests.mjs --serial tests/campaign/desktop-archive-error.test.mjs",
    "test:desktop-legendary-transfer": "node tools/run-tests.mjs --serial tests/runtime/desktop-legendary-transfer-integrity.test.mjs",
    "test:desktop-extension-references": "node tools/run-tests.mjs --serial tests/atlas/desktop-extension-reference-transfer.test.mjs",
    "test:desktop-autonomy-time": "node tools/run-tests.mjs --serial tests/runtime/desktop-autonomy-disable-time.test.mjs",
    "check:repo": "node tools/check-repository.mjs && node tools/build-transfer-contracts.mjs",
    "bench:autonomy": "esbuild tools/measure-autonomy-scale.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=.build/measure-autonomy-scale.cjs && node tools/run-autonomy-scale.mjs",
    "test:repo": "node tools/run-tests.mjs --serial tests/shared/repository-structure.test.mjs",
    "test:adr-p02": "node tools/run-tests.mjs --serial tests/adr-prototypes/p02-contract.test.mjs tests/adr-prototypes/p02-concurrency.test.mjs tests/adr-prototypes/p02-process.test.mjs",
    "adr:p02:matrix": "node tools/adr-prototypes/p02/matrix.mjs --runs 10 --out tools/adr-prototypes/evidence/p02-aggregate.json",
    "test:adr-p03": "npm run desktop:runtime && node tools/run-tests.mjs --serial tests/adr-prototypes/p03-contract.test.mjs tests/adr-prototypes/p03-channel.test.mjs tests/adr-prototypes/p03-renderer.test.mjs tests/adr-prototypes/p03-pixel-oracle.test.mjs tests/adr-prototypes/p03-evidence.test.mjs tests/adr-prototypes/p03-process.test.mjs",
    "adr:p03:probe": "npm run desktop:runtime && electron tools/adr-prototypes/p03/probe-main.mjs --out tools/adr-prototypes/evidence/p03-aggregate.json --frames tools/adr-prototypes/evidence/p03-frames",
    "desktop:runtime": "install-electron",
    "build:desktop": "node tools/build-desktop.mjs",
    "package:desktop": "npm run desktop:runtime && npm run build:desktop && node tools/package-desktop.mjs",
    "check:desktop": "tsc --noEmit -p desktop/tsconfig.json",
    "start:desktop": "npm run desktop:runtime && npm run build:desktop && electron .build/desktop/main.cjs",
    "test:desktop-rule-context": "node tools/run-tests.mjs --serial tests/runtime/desktop-mask-integration.test.mjs tests/catalog/desktop-rule-reference-store.test.mjs tests/catalog/desktop-rule-reference-authority.test.mjs tests/runtime/desktop-chase-transfer.test.mjs",
    "test:desktop-rule-context-ui": "node tools/test-desktop-rule-reading.mjs",
    "test:desktop-groups-search": "node tools/run-tests.mjs --serial tests/campaign/desktop-groups-search.test.mjs",
    "test:desktop-groups-search-ui": "node tools/test-desktop-groups-search.mjs",
    "test:desktop-discovery": "node tools/run-tests.mjs --serial tests/campaign/desktop-key-discovery.test.mjs tests/campaign/desktop-key-store.test.mjs tests/atlas/desktop-surface.test.mjs tests/atlas/desktop-volume-spatial.test.mjs tests/runtime/desktop-finish-draft-dom.test.mjs tests/runtime/desktop-finish-draft-store.test.mjs tests/runtime/desktop-desk-owner-dom.test.mjs tests/catalog/desktop-quick-reference.test.mjs tests/runtime/desktop-desk-integrity.test.mjs tests/runtime/desktop-treasury-integrity.test.mjs tests/runtime/desktop-treasure-batch.test.mjs tests/runtime/desktop-treasure-distribution-context.test.mjs tests/runtime/desktop-treasury-owner-dom.test.mjs tests/catalog/desktop-group-integrity.test.mjs tests/campaign/desktop-group-owner-dom.test.mjs tests/catalog/desktop-session-retention.test.mjs tests/campaign/desktop-world-source-transfer.test.mjs tests/campaign/desktop-world-source-ui.test.mjs tests/catalog/desktop-rule-reference-store.test.mjs tests/catalog/desktop-rule-reference-authority.test.mjs tests/catalog/desktop-npc-integrity.test.mjs tests/campaign/desktop-npc-owner-dom.test.mjs tests/campaign/desktop-world-source-constraints.test.mjs tests/campaign/desktop-session-proposal-dom.test.mjs tests/campaign/desktop-session-proposal-store.test.mjs tests/campaign/desktop-npc-switch.test.mjs tests/catalog/desktop-npc-rename.test.mjs tests/campaign/desktop-npc-search.test.mjs tests/catalog/desktop-generation-npcs.test.mjs tests/runtime/desktop-ledger-switch.test.mjs tests/runtime/desktop-session-magic-pool.test.mjs tests/runtime/desktop-adventuring-day-dom.test.mjs tests/runtime/desktop-party-topbar-dom.test.mjs tests/runtime/desktop-party-award-dom.test.mjs tests/runtime/desktop-party-xp.test.mjs tests/campaign/desktop-preparation-context.test.mjs",
    "test:desktop-split-knowledge": "node tools/test-desktop-split-knowledge.mjs",
    "test:desktop-narrative": "node tools/run-tests.mjs --serial tests/runtime/desktop-narrative-integrity.test.mjs tests/runtime/desktop-narrative-loading.test.mjs tests/runtime/desktop-narrative-journal.test.mjs",
    "test:desktop-narrative-ui": "node tools/test-desktop-narrative-recovery.mjs",
    "test:desktop-travel-target": "node tools/run-tests.mjs --serial tests/runtime/desktop-travel-target-dom.test.mjs",
    "test:desktop-travel-target-ui": "node tools/test-desktop-travel-target.mjs",
    "test:desktop-desk-search": "node tools/run-tests.mjs --serial tests/runtime/desktop-desk-search.test.mjs",
    "test:desktop-desk-search-ui": "node tools/test-desktop-desk-search.mjs",
    "test:desktop-chronicle-search": "node tools/run-tests.mjs --serial tests/runtime/desktop-chronicle-search.test.mjs tests/runtime/desktop-chronicle-store.test.mjs tests/runtime/desktop-chronicle-window.test.mjs",
    "test:desktop-chronicle-ui": "node tools/test-desktop-chronicle-search.mjs",
    "test:desktop-music-stop": "node tools/run-tests.mjs --serial tests/runtime/desktop-music-stop.test.mjs tests/runtime/desktop-soundboard-context.test.mjs tests/runtime/desktop-audio-response.test.mjs",
    "test:desktop-music-stop-ui": "node tools/test-desktop-music-stop.mjs",
    "test:desktop-combat-switch": "node tools/run-tests.mjs --serial tests/runtime/desktop-combat-switch.test.mjs",
    "test:desktop-combat-switch-ui": "node tools/test-desktop-combat-switch.mjs",
    "test:desktop-live-archive": "node tools/run-tests.mjs --serial tests/runtime/desktop-live-archive.test.mjs",
    "test:desktop-live-archive-ui": "node tools/test-desktop-live-archive.mjs",
    "test:desktop-npc-switch": "node tools/run-tests.mjs --serial tests/campaign/desktop-npc-switch.test.mjs",
    "test:desktop-npc-switch-ui": "node tools/test-desktop-npc-switch.mjs",
    "test:desktop-npc-rename": "node tools/run-tests.mjs --serial tests/catalog/desktop-npc-rename.test.mjs",
    "test:desktop-npc-rename-ui": "node tools/test-desktop-npc-rename.mjs",
    "test:desktop-npc-search": "node tools/run-tests.mjs --serial tests/campaign/desktop-npc-search.test.mjs",
    "test:desktop-npc-search-ui": "node tools/test-desktop-npc-search.mjs",
    "test:desktop-chase-switch": "node tools/run-tests.mjs --serial tests/runtime/desktop-chase-switch.test.mjs",
    "test:desktop-workspace-shortcuts": "node tools/run-tests.mjs --serial tests/workspace/desktop-workspace-shortcuts.test.mjs",
    "test:desktop-extension-recovery": "node tools/run-tests.mjs --serial tests/workspace/desktop-extension-recovery.test.mjs",
    "test:desktop-xp-rest-corrections": "node tools/run-tests.mjs --serial tests/runtime/desktop-xp-rest-corrections.test.mjs",
    "test:desktop-day-calculator": "node tools/run-tests.mjs --serial tests/runtime/desktop-day-calculator.test.mjs",
    "test:desktop-audio-recovery": "node tools/run-tests.mjs --serial tests/runtime/desktop-audio-layer-recovery.test.mjs tests/runtime/desktop-music-stop.test.mjs tests/runtime/desktop-soundboard-context.test.mjs",
    "test:desktop-player-privacy-ui": "node tools/test-desktop-player-scene-privacy.mjs && node tools/test-desktop-player-scene-privacy.mjs --combat && node tools/test-desktop-player-scene-privacy.mjs --chase",
    "test:desktop-player-visual": "node tools/run-tests.mjs --serial tests/runtime/desktop-player-visual-contract.test.mjs tests/runtime/desktop-player-visual-host.test.mjs",
    "test:desktop-live-visual-context": "node tools/run-tests.mjs --serial tests/runtime/desktop-live-visual-context.test.mjs",
    "test:desktop-dungeon-binder": "node tools/run-tests.mjs --serial tests/atlas/desktop-dungeon-binder-context.test.mjs",
    "test:desktop-player-focus": "node tools/run-tests.mjs --serial tests/runtime/desktop-player-focus.test.mjs",
    "test:desktop-player-focus-ui": "node tools/test-desktop-player-focus.mjs",
    "test:desktop-player-blank-ui": "node tools/test-desktop-player-blank.mjs && node tools/test-desktop-player-blank.mjs --pending",
    "test:desktop-session-packet": "node tools/run-tests.mjs --serial tests/campaign/desktop-session-packet-context.test.mjs tests/runtime/desktop-session-progress.test.mjs tests/runtime/desktop-scene-visit-context.test.mjs",
    "test:desktop-text-references": "node tools/run-tests.mjs --serial tests/campaign/desktop-text-references.test.mjs tests/campaign/desktop-text-reference-store.test.mjs tests/campaign/desktop-text-reference-completeness.test.mjs tests/catalog/desktop-text-reference-readers.test.mjs",
    "test:desktop-session-resume": "node tools/run-tests.mjs --serial tests/runtime/desktop-session-resume-context.test.mjs",
    "test:desktop-trade-price": "node tools/run-tests.mjs --serial tests/runtime/desktop-trade-paid-price.test.mjs",
    "test:desktop-shop-owner": "node tools/run-tests.mjs --serial tests/runtime/desktop-shop-owner-time.test.mjs tests/runtime/desktop-shop-restock-boundary.test.mjs",
    "test:desktop-key-note-context-ui": "npm run build:desktop && node tools/test-desktop-key-note-context.mjs",
    "test:desktop-long-key-ui": "npm run build:desktop && node tools/test-desktop-long-key.mjs",
    "test:desktop-key-note-capture-ui": "npm run build:desktop && node tools/test-desktop-key-note-capture.mjs",
    "test:desktop-note-room-uses-ui": "npm run build:desktop && node tools/test-desktop-note-room-uses.mjs",
    "test:desktop-key-lookup-ui": "npm run build:desktop && node tools/test-desktop-key-lookup.mjs",
    "dev": "npm run start:desktop --",
    "format": "prettier --write \"src/app/**/*.{ts,css}\" \"desktop/**/*.ts\" \"tests/{workspace,atlas,campaign,runtime,catalog,shared}/**/*.test.mjs\" \"tests/helpers/**/*.{mjs,ts}\" \"tools/{build-desktop,build-transfer-contracts,check-repository,run-tests,test-selection,package-desktop,verify-release-source,native-session,atlas-*,test-desktop-*,measure-*,run-autonomy-scale}.{mjs,ts}\"",
    "format:check": "prettier --check \"src/app/**/*.{ts,css}\" \"desktop/**/*.ts\" \"tests/{workspace,atlas,campaign,runtime,catalog,shared}/**/*.test.mjs\" \"tests/helpers/**/*.{mjs,ts}\" \"tools/{build-desktop,build-transfer-contracts,check-repository,run-tests,test-selection,package-desktop,verify-release-source,native-session,atlas-*,test-desktop-*,measure-*,run-autonomy-scale}.{mjs,ts}\""
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "@math.gl/core": "4.1.0",
    "@noble/hashes": "2.4.0",
    "clipper-lib": "^6.4.2",
    "entities": "8.1.0",
    "fflate": "0.8.3",
    "marked": "18.0.14",
    "pixi.js": "8.22.0",
    "png-tools": "1.1.1",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "three": "0.186.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.183.1",
    "@types/yauzl": "^3.4.0",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "electron": "44.7.0",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.13",
    "obsidian": "^1.8.7",
    "playwright-core": "1.62.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0"
  },
  "productName": "SaltMarcher",
  "description": "Lokaler Arbeitsraum f\u00fcr Kampagnen, Atlas und Spielleitung"
}
