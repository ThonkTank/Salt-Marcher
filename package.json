  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^0.468",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.51",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6",
    "vitest": "^5.0.5"
  }
}
