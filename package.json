{
  "name": "salt-marcher",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first tabletop campaign tool",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "corepack pnpm build && electron out/main/index.js --smoke-test --no-sandbox",
    "test:e2e": "corepack pnpm build && wdio run wdio.conf.ts",
    "check": "corepack pnpm format && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:smoke",
    "package": "corepack enable --install-directory ./node_modules/.bin && corepack pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@babylonjs/core": "9.18.1",
    "better-sqlite3": "13.0.2",
    "pixi.js": "8.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "4.12.1",
    "@electron-toolkit/utils": "4.0.0",
    "@wdio/electron-service": "10.1.0",
    "@wdio/globals": "9.29.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.30.0",
    "@wdio/local-runner": "9.30.0",
    "@wdio/mocha-framework": "9.30.0",
    "@wdio/spec-reporter": "9.29.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "webdriverio": "9.30.0"
  },
  "pnpm": {
    "overrides": {
      "@wdio/native-utils": "2.5.0"
    }
  }
}
