    {"id":"srd51:equipment:weapons:37","name":"Net","category":"equipment","subcategory":"weapon-martial-ranged","magic":false,"attunement":"unspecified","cost":{"sourceText":"1 gp","copperPieces":100},"properties":[{"name":"Special","occurrenceId":"srd51:equipment:weapons:37"},{"name":"Thrown","occurrenceId":"srd51:equipment:weapons:37","description":"range 5/15"}],"description":[{"text":"A Large or smaller creature hit by a net is restrained until it is freed. A net has no effect on creatures that are formless, or creatures that are Huge or larger. A creature can use its action to make a DC 10 Strength check, freeing itself or another creature within its reach on a success. Dealing 5 slashing damage to the net (AC 10) also frees the creature without harming it, ending the effect and destroying the net.","occurrenceId":"srd51:equipment:weapons:37"},{"text":"When you use an action, bonus action, or reaction to attack with a net, you can make only one attack regardless of the number of attacks you can normally make.","occurrenceId":"srd51:equipment:weapons:37"}],"weight":{"sourceText":"3 lb.","pounds":"3"},"source":{"document":"SRD 5.1","pdfUrl":"https://media.wizards.com/2023/downloads/dnd/SRD_CC_v5.1.pdf","pdfPages":[65,66],"printedPages":[65,66],"occurrenceIds":["srd51:equipment:weapons:37"]}}
