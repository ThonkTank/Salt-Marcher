#!/usr/bin/env bash
set -uo pipefail
events="$1" role="$2" worker_id="$3" duration="$4" delay="$5"
pid_file="${6:-}" resistant="${7:-0}" leader_exits="${8:-0}"
[[ "$delay" == 0 || "$delay" == 0.0 ]] || sleep "$delay"
read -r mono _ </proc/uptime
printf '{"event":"begin","id":"%s","role":"%s","mono":%s,"wall_ns":%s,"pid":%s,"pgid":%s}\n' \
    "$worker_id" "$role" "$mono" "$(date +%s%N)" "$$" "$(ps -o pgid= -p $$ | tr -d ' ')" >>"$events"
if [[ -n "$pid_file" ]]; then
    if [[ "$resistant" == 1 ]]; then
        python3 -c 'import signal,sys,time; signal.signal(signal.SIGTERM, signal.SIG_IGN); open(sys.argv[1], "w").close(); time.sleep(30)' "${pid_file}.ready" &
    else
        /bin/sleep 30 &
    fi
    descendant=$!
    printf '%s\n' "$descendant" >"$pid_file"
    if [[ "$resistant" == 1 ]]; then
        while [[ ! -e "${pid_file}.ready" ]]; do sleep 0.002; done
    fi
    if [[ "$leader_exits" == 1 ]]; then
        sleep 0.1
        exit 0
    fi
fi
sleep "$duration"
read -r mono _ </proc/uptime
printf '{"event":"end","id":"%s","role":"%s","mono":%s,"wall_ns":%s,"pid":%s}\n' \
    "$worker_id" "$role" "$mono" "$(date +%s%N)" "$$" >>"$events"
[[ -n "${descendant:-}" ]] && wait "$descendant"
exit 0
