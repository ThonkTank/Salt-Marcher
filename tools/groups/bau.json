      "originalGaps": {
        "DD-011.08": "Alt-Ellipsenschnitt ist im Original nur als Option sichtbar; ein direkter Schnitt mit Boden- und Wandwirkung fehlt.",
        "DD-011.09": "Alt-Polygonschnitt ist im Original nicht direkt ausgeführt oder gespeichert.",
        "DD-011.11": "Die Wirkung eines vor dem Zeichnen gewechselten Bodenmotivs ist nicht isoliert gemessen.",
        "DD-011.12": "Die tatsächliche Tint-Wirkung auf eine gezeichnete Bodenfläche ist nicht einzeln gemessen.",
        "DD-012.02": "Der direkt gezogene Ellipsenpunkt wurde wegen eines nicht sichtbaren Save-Dialogs nicht gespeichert und in einem frischen Originalprozess geprüft.",
        "DD-013.01": "Ein älterer Bildbeleg zeigt Delete als Punktlöschung; zwei neue modfreie Hover-Delete-Versuche bewirkten nichts. Die nötige Vorbedingung und gespeicherte Wirkung sind ungeklärt.",
        "DD-013.02": "Für Backspace am Konturgriff fehlt ein erfolgreicher Originalfall; die neue modfreie Wiederholung blieb ohne sichtbare Wirkung.",
        "DD-013.03": "Mindestpunktzahl und Verhalten beim Entfernen eines Dreiecks- oder Mehrteilkonturpunkts sind nicht gemessen.",
        "DD-014.01": "Die sichtbare Kantenzieh-Einfügung hat keine gemessenen gespeicherten Koordinaten, Undo/Redo oder frischen Originalstart.",
        "DD-014.02": "Wandfolge ist sichtbar, aber die Bindung vorhandener Portale nach eingefügtem Punkt und die gespeicherte Einzelzugwirkung sind nicht geprüft."
      },
      "originalEffects": {
        "DD-011.01": "Bodenfläche und automatische geschlossene Wand; gelbe Maßvorschau.",
        "DD-011.02": "Bodenellipse und umlaufende Wand; 5×3-Zug direkt sichtbar.",
        "DD-011.03": "Bodenpolygon mit geschlossener Wand.",
        "DD-011.04": "Boden und umlaufende Wand einer schmalen Form.",
        "DD-011.05": "Letzter Vorschaupunkt verschwindet.",
        "DD-011.06": "Gekrümmte Building-Kontur mit Boden und Wand.",
        "DD-011.07": "Bodenstück und zugehörige Wand werden entfernt; Undo/Redo belegt.",
        "DD-011.10": "Escape während eines Rechteckzugs hinterließ kein zweites Building.",
        "DD-011.13": "Gespeicherte Building-Punkte liegen zwischen Feldgrenzen.",
        "DD-011.14": "Strg+Z entfernte das Rechteck; Strg+Y stellte es im Original wieder her.",
        "DD-011.15": "Drei Bodenpolygone mit Wänden erhalten.",
        "DD-012.01": "Im Building Tool zeigte Edit Points Griffe an einer gezeichneten Ellipse.",
        "DD-012.03": "Boden und Wand folgen schon vor Loslassen."
      }
