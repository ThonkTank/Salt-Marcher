+test("toolbar undo and redo retain the structured room Key context and applied text", () => {
+  const prepared = new Session(
+      newDocument("Key-Verlauf", 20, 20, undefined, undefined, 4),
+    ),
+    floor = prepared.floors.values().next().value!,
+    room = createRoom(prepared, floor.id, outline(1), "QA/Räume"),
+    section = structuredRoom(prepared, room.id).key.sections[0]!;
+  assert.equal(section.kind, "markdown");
+  editMarkdownSection(prepared, room.id, section.id, "", "Vorher");
+  const session = new Session(prepared.document()), { root } = dom(),
+    notices: string[] = [], panel = new StructuredKeyPanel(
+      { vault: { getName: () => "Test" } } as never,
+      root, session, "QA/Karte.dungeon", room.id, section.id,
+      (message) => notices.push(message), () => true,
+    ),
+    object = createObject(session, floor.id, { x: 12, y: 4 }),
+    methods = DungeonEditor.prototype as unknown as Record<string, Function>;
+  let selection = new Set([room.id]), selected: string | undefined = room.id,
+    cleared = 0;
+  const fake = {
+    session,
+    structuredPanel: panel,
+    allowKeyNavigation: () => panel.allowNavigation(),
+    commitNote() {},
+    cancel() {},
+    select(id: string | undefined) {
+      cleared++;
+      selection = new Set(id ? [id] : []);
+      selected = id;
+      return Promise.resolve();
+    },
+  };
+  const text = () => root.querySelector<HTMLTextAreaElement>(".dn-key-markdown")!;
+  const apply = () => [...root.querySelectorAll<HTMLButtonElement>(".dn-key-controls button")]
+    .find((button) => button.textContent === "Übernehmen")!.click();
+
+  text().value = "Ungespeicherter Entwurf";
+  methods.stepHistory!.call(fake, "undo");
+  assert.equal(session.entities.has(object.id), true);
+  assert.equal(session.canRedo, false);
+  assert.equal(cleared, 0);
+  assert.deepEqual([...selection], [room.id]);
+  assert.equal(selected, room.id);
+  assert.match(notices.at(-1) ?? "", /Übernehmen oder Verwerfen/);
+
+  text().value = "Nachher";
+  apply();
+  assert.equal(text().value, "Nachher");
+  methods.stepHistory!.call(fake, "undo");
+  assert.equal(text().value, "Vorher");
+  assert.equal(session.canRedo, true);
+  assert.equal(cleared, 0);
+  assert.deepEqual([...selection], [room.id]);
+  assert.equal(selected, room.id);
+
+  methods.stepHistory!.call(fake, "redo");
+  assert.equal(text().value, "Nachher");
+  assert.equal(session.canRedo, false);
+  assert.equal(cleared, 0);
+  assert.deepEqual([...selection], [room.id]);
+  assert.equal(selected, room.id);
+  const reopened = new Session(parseDocument(JSON.stringify(session.document()))),
+    reopenedSection = structuredRoom(reopened, room.id).key.sections.find(
+      (candidate) => candidate.id === section.id,
+    );
+  assert.equal(reopenedSection?.kind, "markdown");
+  assert.equal(reopenedSection.markdown, "Nachher");
+  panel.destroy();
+});
+
+test("toolbar history still clears an ordinary canvas selection", () => {
+  const session = new Session(newDocument("Canvas-Verlauf", 20, 20)),
+    floor = session.floors.values().next().value!,
+    object = createObject(session, floor.id, { x: 12, y: 4 }),
+    methods = DungeonEditor.prototype as unknown as Record<string, Function>;
+  let selected: string | undefined = object.id;
+  const fake = {
+    session,
+    structuredPanel: undefined,
+    allowKeyNavigation: () => true,
+    commitNote() {},
+    cancel() {},
+    select(id: string | undefined) {
+      selected = id;
+      return Promise.resolve();
+    },
+  };
+
+  methods.stepHistory!.call(fake, "undo");
+
+  assert.equal(session.entities.has(object.id), false);
+  assert.equal(selected, undefined);
