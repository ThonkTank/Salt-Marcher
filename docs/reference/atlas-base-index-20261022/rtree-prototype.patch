+ f.reader.baseIndex={ready:false,hasColorTile:true,*prepare(){try{for(;;){slices++;yield;}}finally{closed++;}},colorTileCompleted(){published++;}};
+ const steps=f.reader.colorSteps(f.source,{box:boxes[0],routeContext:boxes[0],width:32,height:32,displayMpp:5,contours:0,revision:f.source.revision,fence:f.source.fence});
+ let tile;for(let i=0;i<1000;i++){const s=steps.next();if(s.done){tile=s.value;break;}}
+ assert(tile,'unfinished index must not prevent delivery of a complete tile');assert.equal(tile.pixels.length,32*32*4);assert(slices>0);assert.equal(closed,1);assert.equal(published,1);
