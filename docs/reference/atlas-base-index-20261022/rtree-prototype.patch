+  const moved=f.patch(1,-20,-20),b=bounds(moved);f.store.db.prepare('UPDATE atlas_landscape SET payload=?,min_x=?,max_x=?,min_y=?,max_y=? WHERE id=?').run(JSON.stringify(moved),b.x,b.x+b.width,b.y,b.y+b.height,moved.id);
