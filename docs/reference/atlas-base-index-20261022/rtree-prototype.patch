+ f.db.exec=sql=>{if(sql.includes('CREATE VIRTUAL TABLE temp.landscape_base_index')){attempts++;original("CREATE INDEX temp.landscape_base_source ON landscape_shape_bounds(source_row) WHERE terrain_kind='base'");throw Error('no such module: rtree');}return original(sql);};
+ finish(f.reader.baseIndex.prepare());finish(f.reader.baseIndex.prepare());assert.equal(attempts,1);assert(!f.reader.baseIndex.ready);assert.deepEqual(f.scan(boxes[0]),expected);assert.equal(f.db.prepare("SELECT name FROM temp.sqlite_master WHERE name='landscape_base_source'").get(),undefined);
