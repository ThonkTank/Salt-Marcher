@@ -0,0 +1,53 @@
+/** Disposable spatial acceleration for dense base terrain. Build only during
+ * colour refinement, in short pages; the first overview keeps its scan path.
+ * Progress lives in SQLite so cancellation and transaction rollback cannot
+ * publish a partly populated index. Metadata triggers track later edits. */
+export class LandscapeBaseIndex {
+ constructor(private db:any){
+  // status: 0 absent, 1 building, 2 ready, -1 Rtree unavailable.
+  db.exec('CREATE TEMP TABLE landscape_base_progress(status INTEGER NOT NULL,after_row TEXT,refined INTEGER NOT NULL); INSERT INTO landscape_base_progress VALUES(0,NULL,0)');
+ }
+ private state(){return this.db.prepare('SELECT status,after_row,refined FROM temp.landscape_base_progress').get();}
+ get ready(){return this.state().status===2;}
+ get hasColorTile(){return this.state().refined===1;}
+ colorTileCompleted(){if(!this.hasColorTile)this.db.prepare('UPDATE temp.landscape_base_progress SET refined=1').run();}
+ reset(){
+  if(this.state().status>0)this.db.exec(`DROP TRIGGER temp.landscape_base_insert; DROP TRIGGER temp.landscape_base_delete; DROP TRIGGER temp.landscape_base_update;
+   DROP TABLE temp.landscape_base_index; DROP INDEX temp.landscape_base_source`);
+  this.db.exec('UPDATE temp.landscape_base_progress SET status=CASE WHEN status=-1 THEN -1 ELSE 0 END,after_row=NULL,refined=0');
+ }
+ *prepare():Generator<void>{
+  const initial=this.state();if(initial.status===2||initial.status===-1)return;
+  if(initial.status===0){
+   try{this.db.transaction(()=>this.db.exec(`
+    CREATE INDEX temp.landscape_base_source ON landscape_shape_bounds(source_row) WHERE terrain_kind='base';
+    CREATE VIRTUAL TABLE temp.landscape_base_index USING rtree(id,min_x,max_x,min_y,max_y);
+    CREATE TEMP TRIGGER landscape_base_insert AFTER INSERT ON landscape_shape_bounds WHEN new.terrain_kind='base' BEGIN
+     INSERT OR REPLACE INTO landscape_base_index VALUES(new.source_row,new.min_x,new.max_x,new.min_y,new.max_y); END;
+    CREATE TEMP TRIGGER landscape_base_delete AFTER DELETE ON landscape_shape_bounds WHEN old.terrain_kind='base' BEGIN
+     DELETE FROM landscape_base_index WHERE id=old.source_row; END;
+    CREATE TEMP TRIGGER landscape_base_update AFTER UPDATE ON landscape_shape_bounds WHEN old.terrain_kind='base' OR new.terrain_kind='base' BEGIN
+     DELETE FROM landscape_base_index WHERE id=old.source_row;
+     INSERT OR REPLACE INTO landscape_base_index SELECT new.source_row,new.min_x,new.max_x,new.min_y,new.max_y WHERE new.terrain_kind='base'; END;
+    UPDATE temp.landscape_base_progress SET status=1,after_row=NULL`))();}
+   catch(error){if(!/no such module: rtree/.test(String(error)))throw error;this.db.prepare('UPDATE temp.landscape_base_progress SET status=-1').run();return;}
+   yield;
+  }
+  // Keep coordinates inside SQLite: one bulk insert per page avoids 100,000
+  // JS objects and individual statement calls on a full world.
+  const statements=['', ' AND source_row>?'].map(after=>{
+   const page="FROM temp.landscape_shape_bounds WHERE terrain_kind='base'"+after+' ORDER BY source_row LIMIT 256';
+   return{
+    last:this.db.prepare('SELECT count(*) n,CAST(max(source_row) AS TEXT) id FROM (SELECT source_row '+page+')'),
+    insert:this.db.prepare('INSERT OR REPLACE INTO temp.landscape_base_index SELECT source_row,min_x,max_x,min_y,max_y '+page),
+   };
+  }),progress=this.db.prepare('UPDATE temp.landscape_base_progress SET status=?,after_row=?');
+  const page=this.db.transaction(()=>{
+   const state=this.state();if(state.status!==1)return true;
+   const args=state.after_row===null?[]:[state.after_row],sql=statements[args.length]!,last=sql.last.get(...args);
+   sql.insert.run(...args);
+   const done=last.n<256;progress.run(done?2:1,last.id??state.after_row);return done;
+  });
+  for(;;){const start=performance.now();do{if(page())return;}while(performance.now()-start<8);yield;}
+ }
+}
