+import {homedir} from 'node:os';
+const require=createRequire(import.meta.url),Database=require('better-sqlite3');
+buildSync({stdin:{contents:"export * from './src/app/storage/store';export * from './src/app/storage/atlas-landscape-region';export * from './src/app/atlas-landscape';",resolveDir:process.cwd()},outfile:'.build/terrain-base-index-test.cjs',bundle:true,platform:'node',format:'cjs',external:['better-sqlite3']});
+const {CampaignStore,AtlasLandscapeReader,emptyRecord,bounds}=require('../.build/terrain-base-index-test.cjs');
+function fixture(t){
+ const root=homedir()+'/.cache/saltmarcher/tests';mkdirSync(root,{recursive:true});const dir=mkdtempSync(root+'/terrain-base-'),store=new CampaignStore(dir+'/world.sqlite'),campaign=store.create('Base terrain index'),token=store.activateShell(campaign.id).token;
+ t.after(()=>{db.close();store.close();rmSync(dir,{recursive:true,force:true});});
+ const insert=store.db.prepare('INSERT INTO atlas_landscape(rowid,campaign_id,id,revision,min_x,max_x,min_y,max_y,payload) VALUES(?,?,?,?,?,?,?,?,?)');
+ function patch(i,x=(i%80)*17.3,y=Math.floor(i/80)*19.7){return{...emptyRecord('patch'),id:'base:'+i,resolution:2**(i%4),order:i%3?i%7:undefined,values:{terrain:i%2?'forest':'desert'},polygons:[{outer:[{x,y},{x:x+32,y},{x:x+32,y:y+28},{x,y:y+28}],holes:[]}]};}
+ function put(r,row){const b=bounds(r);insert.run(String(row),campaign.id,r.id,1,b.x,b.x+b.width,b.y,b.y+b.height,JSON.stringify(r));}
+ store.db.transaction(()=>{for(let i=0;i<4000;i++)put(patch(i),9007199254740993n+BigInt(i));})();
+ const db=new Database(store.filename,{readonly:true}),reader=new AtlasLandscapeReader(db);let source=store.atlasRegionSource(token);reader.sync(source);
+ return{store,db,reader,patch,put,get source(){return source;},sync(ids){source=ids?{...source,reset:false,changes:ids.map(id=>({table:'atlas_landscape',id}))}:store.atlasRegionSource(token,source);reader.sync(source);},scan(box,samples){return[...reader.terrainStream(source)('base',box,samples)];}};
+}
+function finish(steps){let yields=0;for(;;){const next=steps.next();if(next.done)return{yields,value:next.value};yields++;}}
+const boxes=[{x:30,y:10,width:145,height:128},{x:123.456789,y:234.56789,width:.00003,height:.00004},{x:-100,y:-100,width:2000,height:1500}];
+function parity(f){for(const box of boxes)for(const samples of [undefined,{columns:37,rows:29}]){const actual=f.scan(box,samples),index=f.reader.baseIndex;try{f.reader.baseIndex={ready:false};assert.deepEqual(actual,f.scan(box,samples));}finally{f.reader.baseIndex=index;}}}
+test('base refinement builds cooperatively after overview, preserves painter order and exact Float64/sample bounds',t=>{
+ const f=fixture(t);assert(!f.reader.baseIndex.ready);f.scan(boxes[0]);assert.equal(f.db.prepare("SELECT name FROM temp.sqlite_master WHERE name='landscape_base_index'").get(),undefined);
+ const query={box:boxes[0],routeContext:boxes[0],width:32,height:32,revision:f.source.revision,fence:f.source.fence,contours:0,displayMpp:5};
+ f.db.exec('BEGIN');finish(f.reader.colorSteps(f.source,query));assert(f.reader.baseIndex.hasColorTile);f.db.exec('ROLLBACK');assert(!f.reader.baseIndex.hasColorTile);
+ finish(f.reader.colorSteps(f.source,query));assert(!f.reader.baseIndex.ready);assert(f.reader.baseIndex.hasColorTile);assert.equal(f.db.prepare("SELECT name FROM temp.sqlite_master WHERE name='landscape_base_index'").get(),undefined,'first sharp tile publishes before index build');
+ const steps=f.reader.colorSteps(f.source,query);assert.equal(steps.next().done,false);assert(!f.reader.baseIndex.ready,'an unfinished index never supplies candidates');
