+ // Finish each SQL page before yielding, so source edits can update the Rtree.
+ const from=spatial?'temp.landscape_base_index i CROSS JOIN temp.landscape_shape_bounds m ON m.source_row=i.id':'temp.landscape_shape_bounds';
+ const candidates=spatial?'i.max_x>=? AND i.min_x<=? AND i.max_y>=? AND i.min_y<=? AND ':'';
+ const where=candidates+`${prefix}terrain_kind='${kind}' AND ${prefix}max_x>=? AND ${prefix}min_x<=? AND ${prefix}max_y>=? AND ${prefix}min_y<=?`+filter.sql;
+ const args=[...(spatial?range:[]),...range,...filter.args],order=keys.join(',');
+ const first=prepare(`SELECT ${fields} FROM ${from} WHERE ${where} ORDER BY ${order} LIMIT 128`);
