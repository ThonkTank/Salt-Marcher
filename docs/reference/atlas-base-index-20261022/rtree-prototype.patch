+});
+test('cancelled and rolled-back builds resume without missing pages or accepting incomplete indexes',t=>{
+ const f=fixture(t);f.db.exec('BEGIN');const cancelled=f.reader.baseIndex.prepare();assert(!cancelled.next().done);f.db.exec('ROLLBACK');assert(!f.reader.baseIndex.ready);assert.equal(f.db.prepare("SELECT name FROM temp.sqlite_master WHERE name='landscape_base_index'").get(),undefined);
