+import type {TerrainGrid} from './terrain-spatial-model';
+import {terrainGridLayout} from './terrain-grid-layout';
+
+type Indices=Uint16Array|Uint32Array;
+
+/** Full author topology, also restored before a provisional height edit. */
+export function terrainRegularIndices(columns:number,rows:number,indices:Indices){
+  let at=0;
+  for(let y=0;y<rows-1;y++)for(let x=0;x<columns-1;x++){
+    const i=y*columns+x;
+    indices[at++]=i;indices[at++]=i+columns;indices[at++]=i+1;
+    indices[at++]=i+1;indices[at++]=i+columns;indices[at++]=i+columns+1;
+  }
+  return at;
+}
+
+/** Collapse only planar patches, retaining every boundary sample. Adjacent
+ * patches therefore share identical edge segments, including focus-band seams.
+ * No height, UV, source sample or picking topology is resampled. Each sample
+ * must lie within 10 µm of the plane, bounding the difference between the two
+ * interpolated surfaces to 20 µm before GPU rounding, independently of zoom.
+ * Curved patches keep the original diagonal in every cell. The caller owns one
+ * bounded, reusable index buffer. */
+export function terrainPlanarIndices(grid:TerrainGrid,indices:Indices){
+  const {view,heights}=grid,{x,y}=terrainGridLayout(view),columns=view.columns;
+  let at=0;
+  function triangle(a:number,b:number,c:number){indices[at++]=a;indices[at++]=b;indices[at++]=c;}
+  function visit(left:number,top:number,right:number,bottom:number){
+    const width=right-left,height=bottom-top;
+    if(width>=4&&height>=4){
+      const z=heights[top*columns+left]!,ox=x.values[left]!,oy=y.values[top]!;
+      const sx=(heights[top*columns+right]!-z)/(x.values[right]!-ox),sy=(heights[bottom*columns+left]!-z)/(y.values[bottom]!-oy);
+      let planar=true;
+      outer:for(let row=top;row<=bottom;row++)for(let column=left;column<=right;column++){
+        if(Math.abs(heights[row*columns+column]!-(z+(x.values[column]!-ox)*sx+(y.values[row]!-oy)*sy))>1e-5){planar=false;break outer;}
+      }
+      if(planar){
+        const center=Math.floor((top+bottom)/2)*columns+Math.floor((left+right)/2);
+        for(let row=top;row<bottom;row++)triangle(center,row*columns+left,(row+1)*columns+left);
+        for(let column=left;column<right;column++)triangle(center,bottom*columns+column,bottom*columns+column+1);
+        for(let row=bottom;row>top;row--)triangle(center,row*columns+right,(row-1)*columns+right);
+        for(let column=right;column>left;column--)triangle(center,top*columns+column,top*columns+column-1);
+        return;
+      }
+      const mx=Math.floor((left+right)/2),my=Math.floor((top+bottom)/2);
+      visit(left,top,mx,my);visit(mx,top,right,my);visit(left,my,mx,bottom);visit(mx,my,right,bottom);
+      return;
+    }
+    for(let row=top;row<bottom;row++)for(let column=left;column<right;column++){
+      const i=row*columns+column;triangle(i,i+columns,i+1);triangle(i+1,i+columns,i+columns+1);
+    }
+  }
+  visit(0,0,view.columns-1,view.rows-1);
+  return at;
+}
