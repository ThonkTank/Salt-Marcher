+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {buildSync} from 'esbuild';
+import {createRequire} from 'node:module';
+buildSync({stdin:{resolveDir:process.cwd(),contents:"export * from './src/app/terrain-mesh-indices';export * from './src/app/terrain-grid-layout';export * from './src/app/terrain-surface-mesh';export * from './src/app/terrain-spatial-model';export * from './src/app/terrain-contours';export * from './src/app/terrain-draft-material';export * as THREE from 'three';"},outfile:'.build/terrain-planar-mesh-test.cjs',bundle:true,platform:'node',format:'cjs'});
+const {terrainPlanarIndices,terrainRegularIndices,terrainGridLayout,updateTerrainMesh,restoreTerrainAuthorIndices,terrainContourUniforms,gridHeight,TerrainDraftMaterial,THREE}=createRequire(import.meta.url)('../.build/terrain-planar-mesh-test.cjs');
+function fixture(columns=33,rows=33){
+ const view={columns,rows,box:{x:-300,y:-240,width:600,height:480},frame:{x:-200,y:-160,width:400,height:320},refinement:{x:-150,y:-120,width:300,height:240},focusM:100,tilt:0,rotation:0,exaggeration:1};
+ return {view,heights:new Float32Array(columns*rows).fill(100),seaLevelM:0};
+}
+const data=grid=>({grid,width:2,height:2,pixels:new Uint8Array(16).fill(255)});
+function mesh(grid){return updateTerrainMesh(null,data(grid),null,{x:0,y:0},{x:0,y:0},undefined,terrainContourUniforms()).mesh;}
+function dispose(m){m.geometry.dispose();m.material.map.dispose();m.material.dispose();}
+
+test('world-sized empty sea draws under one percent of the author triangles without removing samples',()=>{
+ const grid=fixture(257,257),m=mesh(grid),full=256*256*6;
+ assert(m.geometry.drawRange.count<full/100);assert.equal(m.geometry.getAttribute('position').count,257*257);
+ assert.equal(m.geometry.index.array.length,full);dispose(m);
+});
+test('non-square planar and partly curved fields retain ray heights, winding and watertight shared edges',()=>{
+ for(const curved of [false,true]){
+  const g=fixture(37,29),l=terrainGridLayout(g.view),n=g.view.columns;
+  for(let row=0;row<g.view.rows;row++)for(let col=0;col<n;col++)g.heights[row*n+col]=100+(curved?Math.max(0,30-Math.hypot(col-13,row-13)*6):0);
+  const m=mesh(g);m.updateMatrixWorld(true);const indices=m.geometry.index.array,count=m.geometry.drawRange.count,edges=new Map();
+  for(let i=0;i<count;i+=3){
+   const tri=Array.from(indices.subarray(i,i+3));
+   const points=tri.map(j=>({x:l.x.values[j%n],y:l.y.values[Math.floor(j/n)]}));
+   assert((points[1].x-points[0].x)*(points[2].y-points[0].y)-(points[1].y-points[0].y)*(points[2].x-points[0].x)<0,'front-facing, nondegenerate');
+   for(let j=0;j<3;j++){const a=tri[j],b=tri[(j+1)%3],key=[Math.min(a,b),Math.max(a,b)].join(':');edges.set(key,(edges.get(key)??0)+1);}
+  }
+  for(const [key,uses]of edges){const [a,b]=key.split(':').map(Number),ax=a%n,ay=Math.floor(a/n),bx=b%n,by=Math.floor(b/n);const boundary=ax===bx&&(ax===0||ax===n-1)||ay===by&&(ay===0||ay===g.view.rows-1);assert.equal(uses,boundary?1:2,key);}
+  for(let row=0;row<g.view.rows-1;row++)for(let col=0;col<n-1;col++)for(const [u,v]of [[.13,.23],[.83,.77]]){
+   const p={x:l.x.values[col]*(1-u)+l.x.values[col+1]*u,y:l.y.values[row]*(1-v)+l.y.values[row+1]*v};
+   const hits=new THREE.Raycaster(new THREE.Vector3(p.x,-p.y,1000),new THREE.Vector3(0,0,-1)).intersectObject(m);
+   assert(hits.length);assert(Math.abs(hits[0].point.z+g.view.focusM-gridHeight(g,p))<.00003);
+  }
+  dispose(m);
+ }
+});
+test('a one-sample ridge cannot disappear inside an otherwise planar patch',()=>{
+ const g=fixture(),n=g.view.columns;g.heights[17*n+21]=200;
+ const indices=new Uint16Array((n-1)*(n-1)*6),count=terrainPlanarIndices(g,indices);
+ assert(indices.subarray(0,count).includes(17*n+21));assert(count<indices.length);
+});
+test('sloping planes preserve their elevation gradient and UV coordinates across nonuniform focus bands',()=>{
+ const g=fixture(),l=terrainGridLayout(g.view),n=g.view.columns;
+ for(let row=0;row<g.view.rows;row++)for(let col=0;col<n;col++)g.heights[row*n+col]=100+l.x.values[col]*.125+l.y.values[row]*.25;
+ const m=mesh(g);m.updateMatrixWorld(true);assert(m.geometry.drawRange.count<m.geometry.index.count/4);
+ for(let x=-299;x<300;x+=23)for(let y=-239;y<240;y+=29){
+  const hit=new THREE.Raycaster(new THREE.Vector3(x,-y,1000),new THREE.Vector3(0,0,-1)).intersectObject(m)[0];
+  assert(hit);assert(Math.abs(hit.point.z+100-gridHeight(g,{x,y}))<.00003);
+  assert(Math.abs(hit.uv.x-(x+300)/600)<1e-7);assert(Math.abs(hit.uv.y-(y+240)/480)<1e-7);
+ }
+ dispose(m);
+});
+test('restoring author indices precedes a draft bend, reuses the buffer, and confirmed flat data compacts again',()=>{
+ const g=fixture(),m=mesh(g),geometry=m.geometry,index=geometry.index,position=geometry.getAttribute('position');
+ g.editing={ground:g.heights.slice(),water:new Float32Array(g.heights.length)};
+ const draft=new TerrainDraftMaterial();draft.attach(m,g);restoreTerrainAuthorIndices(geometry,g);
+ assert.equal(geometry.drawRange.count,index.count);const expected=new Uint16Array(index.count);terrainRegularIndices(g.view.columns,g.view.rows,expected);assert.deepEqual(index.array,expected);
+ const version=index.version;restoreTerrainAuthorIndices(geometry,g);assert.equal(index.version,version,'once per draft, not every move');
+ const changed={...g,heights:g.heights.slice()},at=16*g.view.columns+16;changed.heights[at]=500;
+ draft.update(m,changed,changed.heights,{x:16,y:16,width:1,height:1});m.updateMatrixWorld(true);
+ const hit=new THREE.Raycaster(new THREE.Vector3(0,0,1000),new THREE.Vector3(0,0,-1)).intersectObject(m)[0];assert(Math.abs(hit.point.z-400)<.001);
+ updateTerrainMesh(m,data(g),g,{x:0,y:0},{x:0,y:0},undefined,terrainContourUniforms());
+ assert.equal(m.geometry,geometry);assert.equal(geometry.index,index);assert.equal(geometry.getAttribute('position'),position);assert(geometry.drawRange.count<index.count);dispose(m);
+});
diff --git a/tools/test-desktop-terrain-planar-mesh.mjs b/tools/test-desktop-terrain-planar-mesh.mjs
