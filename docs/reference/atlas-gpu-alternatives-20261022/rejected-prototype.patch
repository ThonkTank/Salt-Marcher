+import {buildSync} from 'esbuild';
+import assert from 'node:assert/strict';
+import {writeFile} from 'node:fs/promises';
+import path from 'node:path';
+import {createNativeSession} from './native-session.mjs';
+
+// Compare the production surface with its full author triangulation in the same
+// native GPU context. Timer pairs alternate order; no readback between A and B.
+const probe=buildSync({stdin:{resolveDir:process.cwd(),contents:`
+ import {TerrainSpatialView} from './src/app/terrain-spatial-view';
+ import {terrainRegularIndices} from './src/app/terrain-mesh-indices';
+ import {terrainGridLayout} from './src/app/terrain-grid-layout';
+ export async function run(){
+  const canvas=document.createElement('canvas');canvas.style.cssText='position:fixed;left:0;top:0;width:960px;height:720px;z-index:999999';document.body.append(canvas);
+  const view=new TerrainSpatialView(canvas,1),gl=view.renderer.getContext(),ext=gl.getExtension('EXT_disjoint_timer_query_webgl2');
+  const tick=()=>new Promise(r=>requestAnimationFrame(r));
+  const read=()=>{const bytes=new Uint8Array(canvas.width*canvas.height*4);gl.readPixels(0,0,canvas.width,canvas.height,gl.RGBA,gl.UNSIGNED_BYTE,bytes);return bytes;};
+  const measurements=[],images=[],timings=[];let reference;
+  try{
+   for(const scale of [1,100000])for(const field of ['sea','island','waves']){
+    const frame={x:-200*scale,y:-150*scale,width:400*scale,height:300*scale};
+    const pose={box:{x:-600*scale,y:-600*scale,width:1200*scale,height:1200*scale},frame,refinement:{x:-300*scale,y:-225*scale,width:600*scale,height:450*scale},columns:257,rows:257,focusM:0,tilt:0,rotation:0,exaggeration:1};
+    const l=terrainGridLayout(pose),height=(x,y)=>field==='sea'?0:field==='waves'?40+30*Math.sin(x/60)*Math.cos(y/40):Math.max(0,40*(1-Math.hypot(x/160,y/110)));
+    const heights=Float32Array.from({length:257*257},(_,i)=>height(l.x.values[i%257]/scale,l.y.values[Math.floor(i/257)]/scale));
+    const pixels=new Uint8Array(128*128*4),forest=new Uint8Array(128*128);
+    for(let y=0;y<128;y++)for(let x=0;x<128;x++){
+     const at=y*128+x,h=height((x+.5)/128*1200-600,(y+.5)/128*1200-600),color=h>0?[175+Math.min(45,h),185,130]:[107,166,185];
+     pixels.set([...color,255],at*4);forest[at]=h>0?170:0;
+    }
+    view.setData({generation:0,source:'planar-probe',draft:false,grid:{view:pose,heights,seaLevelM:0},width:128,height:128,pixels,forest});view.setContours(-1);
+    const compact=view.mesh.geometry;reference=compact.clone();const index=reference.index;
+    terrainRegularIndices(257,257,index.array);index.needsUpdate=true;reference.setDrawRange(0,index.count);
+    for(const [tilt,rotation] of [[0,0],[45,23],[70,-47]])for(const tile of [false,true]){
+     view.reframe(frame,tilt,rotation,false);
+     const draw=geometry=>{view.mesh.geometry=geometry;if(tile)view.renderTile(1920,1440,480,360,960,720);else view.render();};
+     draw(reference);const expected=read();draw(compact);const actual=read();let max=0,changed=0,large=0,total=0;
+     for(let i=0;i<actual.length;i+=4){let pixel=0;for(let c=0;c<3;c++){const d=Math.abs(actual[i+c]-expected[i+c]);max=Math.max(max,d);pixel=Math.max(pixel,d);total+=d;}if(pixel)changed++;if(pixel>2)large++;}
+     measurements.push({scale,field,tilt,rotation,tile,indices:compact.drawRange.count,full:index.count,max,changed,large,mean:total/(canvas.width*canvas.height*3)});
+     if(field==='island'&&scale===1&&tilt===45&&!tile)images.push({name:'island',data:canvas.toDataURL('image/png')});
+    }
+    view.reframe(frame,0,0,false);
+    if(ext){
+     for(let i=0;i<20;i++){await tick();view.mesh.geometry=reference;view.render();view.mesh.geometry=compact;view.render();}
+     const pending=[];
+     for(let i=0;i<40;i++){
+      await tick();const pair={};
+      for(const [name,geometry] of (i%2?[['compact',compact],['reference',reference]]:[['reference',reference],['compact',compact]])){
+       view.mesh.geometry=geometry;const q=gl.createQuery();gl.beginQuery(ext.TIME_ELAPSED_EXT,q);view.render();gl.endQuery(ext.TIME_ELAPSED_EXT);pair[name]=q;
+      }pending.push(pair);
+     }
+     while(pending.some(p=>!gl.getQueryParameter(p.reference,gl.QUERY_RESULT_AVAILABLE)||!gl.getQueryParameter(p.compact,gl.QUERY_RESULT_AVAILABLE)))await tick();
+     if(gl.getParameter(ext.GPU_DISJOINT_EXT))throw Error('Disjoint GPU timers');
+     const samples=pending.map(p=>{const a=gl.getQueryParameter(p.reference,gl.QUERY_RESULT)/1e6,b=gl.getQueryParameter(p.compact,gl.QUERY_RESULT)/1e6;gl.deleteQuery(p.reference);gl.deleteQuery(p.compact);return{reference:a,compact:b,ratio:b/a};});
+     const median=key=>samples.map(s=>s[key]).sort((a,b)=>a-b)[20];timings.push({scale,field,referenceMedian:median('reference'),compactMedian:median('compact'),ratioMedian:median('ratio'),samples});
+    }
+    view.mesh.geometry=compact;reference.dispose();reference=undefined;
+   }
+   if(gl.getError())throw Error('WebGL error');return{measurements,timings,images};
+  }finally{reference?.dispose();view.dispose();canvas.remove();}
+ }
+ `},bundle:true,format:'iife',globalName:'PlanarMeshProbe',write:false}).outputFiles[0].text;
+const output=path.resolve(process.env.QA_EVIDENCE_DIR??'.build/terrain-planar-mesh');
+const native=await createNativeSession({output,name:'terrain-planar-mesh'});
+try{
+ const page=await native.launch(),result=await page.evaluate('(async()=>{'+probe+';return PlanarMeshProbe.run();})()');
+ for(const image of result.images)await writeFile(path.join(output,image.name+'.png'),Buffer.from(image.data.split(',')[1],'base64'));delete result.images;
+ await writeFile(path.join(output,'measurements.json'),JSON.stringify(result,null,2));
+ // Permit only isolated rasterisation edge pixels, not shifted lines or seams.
+ for(const row of result.measurements){assert(row.mean<.001,JSON.stringify(row));assert(row.large<10,JSON.stringify(row));assert(row.max<=16,JSON.stringify(row));}
+ await native.close();await native.finish(result);console.log(JSON.stringify({measurements:result.measurements,timings:result.timings.map(({samples,...r})=>r)}));
+}catch(error){await native.fail(error);throw error;}finally{await native.dispose();}
