+/** A draft may bend a previously planar patch. Restore its author triangles
+ * once before the first changed vertex, reusing the existing GPU index buffer. */
+export function restoreTerrainAuthorIndices(geometry:THREE.BufferGeometry,grid:TerrainGrid){
+  const count=(grid.view.columns-1)*(grid.view.rows-1)*6;
+  if(geometry.drawRange.count===count)return;
+  const index=geometry.index!;
+  terrainRegularIndices(grid.view.columns,grid.view.rows,index.array as Uint16Array|Uint32Array);
+  index.clearUpdateRanges();index.addUpdateRange(0,count);index.needsUpdate=true;geometry.setDrawRange(0,count);
+}
