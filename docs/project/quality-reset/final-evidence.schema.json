{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salt-marcher.local/schemas/final-evidence.schema.json",
  "title": "SaltMarcher Final Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "application",
    "candidate",
    "handoff",
    "artifact",
    "installation",
    "main",
    "ledger",
    "reproduction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "complete" },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "workspaceFingerprint",
        "appBuildInputFingerprint",
        "dirty",
        "toolchain",
        "versions"
      ],
      "properties": {
        "sha": { "$ref": "#/$defs/sha" },
        "workspaceFingerprint": { "$ref": "#/$defs/hash" },
        "appBuildInputFingerprint": { "$ref": "#/$defs/hash" },
        "dirty": { "const": false },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "pnpm",
            "electron",
            "electronVite",
            "electronBuilder",
            "platform",
            "arch"
          ],
          "properties": {
            "node": { "type": "string", "minLength": 1 },
            "pnpm": { "type": "string", "minLength": 1 },
            "electron": { "type": "string", "minLength": 1 },
            "electronVite": { "type": "string", "minLength": 1 },
            "electronBuilder": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 },
            "arch": { "type": "string", "minLength": 1 }
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "installationSchema",
            "campaignSchema",
            "migrationRegistry",
            "encounterEngine",
            "rewardEngine",
            "config",
            "catalogVersion",
            "catalogHash"
          ],
          "properties": {
            "installationSchema": { "type": "integer", "minimum": 0 },
            "campaignSchema": { "type": "integer", "minimum": 0 },
            "migrationRegistry": { "type": "integer", "minimum": 0 },
            "encounterEngine": { "type": ["string", "integer"] },
            "rewardEngine": { "type": ["string", "integer"] },
            "config": { "type": ["string", "integer"] },
            "catalogVersion": { "type": ["string", "integer"] },
            "catalogHash": { "$ref": "#/$defs/hash" }
          }
        }
      }
    },
    "candidate": { "$ref": "#/$defs/workflowEvidence" },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "mode",
        "freshInvocationCountForApplicationSha",
        "exactlyOnce",
        "startedAt",
        "completedAt",
        "steps"
      ],
      "properties": {
        "invocationId": { "type": "string", "format": "uuid" },
        "mode": { "const": "fresh" },
        "freshInvocationCountForApplicationSha": { "const": 1 },
        "exactlyOnce": { "const": true },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "steps": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/handoffStep" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "manifestSha256", "outputHash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "manifestSha256": { "$ref": "#/$defs/hash" },
        "outputHash": { "$ref": "#/$defs/hash" }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactSha256",
        "manifestSha256",
        "utilityReady",
        "generation",
        "bootstrap",
        "backup",
        "quickChecks",
        "domainReadbacks"
      ],
      "properties": {
        "artifactSha256": { "$ref": "#/$defs/hash" },
        "manifestSha256": { "$ref": "#/$defs/hash" },
        "utilityReady": { "const": true },
        "generation": { "type": "integer", "minimum": 1 },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalMs", "phases"],
          "properties": {
            "totalMs": { "type": "number", "minimum": 0 },
            "phases": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "manifestSha256",
            "fileCount",
            "databaseCount"
          ],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "manifestSha256": { "$ref": "#/$defs/hash" },
            "fileCount": { "type": "integer", "minimum": 1 },
            "databaseCount": { "type": "integer", "minimum": 1 }
          }
        },
        "quickChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "result"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "result": { "const": "ok" }
            }
          }
        },
        "domainReadbacks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "expected", "actual", "passed"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "expected": {},
              "actual": {},
              "passed": { "const": true }
            }
          }
        }
      }
    },
    "main": { "$ref": "#/$defs/workflowEvidence" },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "total",
        "verified",
        "notApplicable",
        "open",
        "inProgress",
        "blocked"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "total": { "type": "integer", "minimum": 1 },
        "verified": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 },
        "open": { "const": 0 },
        "inProgress": { "const": 0 },
        "blocked": { "const": 0 }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "platformRole", "conclusion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "platformRole": { "type": "string", "minLength": 1 },
        "conclusion": { "const": "success" }
      }
    },
    "workflowEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "url",
        "attempt",
        "headSha",
        "requiredJobManifestVersion",
        "jobs"
      ],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "attempt": { "type": "integer", "minimum": 1 },
        "headSha": { "$ref": "#/$defs/sha" },
        "requiredJobManifestVersion": { "type": "integer", "minimum": 1 },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/job" }
        }
      }
    },
    "handoffStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "startedAt",
        "durationMs",
        "outputHash"
      ],
      "properties": {
        "name": {
          "enum": [
            "check",
            "package",
            "packaged-smoke",
            "backup-and-install",
            "installed-runtime-verification"
          ]
        },
        "status": { "const": "completed" },
        "startedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "outputHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
