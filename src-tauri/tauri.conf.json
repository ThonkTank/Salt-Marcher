{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaltMarcher",
  "version": "0.3.1",
  "identifier": "app.saltmarcher.atlas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SaltMarcher \u00b7 Atlas",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Lokaler Weltatlas mit Gelände und Gebäuden",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
