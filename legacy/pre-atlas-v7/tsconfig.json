{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "resolveJsonModule": true, "skipLibCheck": true, "esModuleInterop": true,
    "types": ["node"], "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "desktop/**/*.ts"]
}
